# docker-compose reads this file automatically. Copy to `.env` and edit.
#   cp .env.example .env

# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_USER=fundsroom
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=fundsroom

# ── JWT secrets (generate strong random values) ────────────
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-bytes-aaaaaaaa
JWT_REFRESH_SECRET=replace-with-a-DIFFERENT-long-random-string-at-least-32-bytes
