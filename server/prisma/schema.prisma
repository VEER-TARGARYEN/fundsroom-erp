// ─────────────────────────────────────────────────────────────────────────────
// Fundsroom ERP + CRM — PostgreSQL schema (Prisma 6)
//
// Conventions:
//   • Models are PascalCase; tables/columns are mapped to snake_case (@map/@@map).
//   • Money is Decimal(@db.Decimal) — NEVER Float — to avoid rounding drift.
//   • UUID primary keys; foreign keys are indexed; enums model fixed domains.
//   • A DB-level CHECK (stock_quantity >= 0) is added at startup (see
//     src/db/constraints.ts) so zero-negative-stock is guaranteed by the
//     database, not only by application code.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
  // `native` covers local dev (Windows/macOS/Linux); the debian target is for the
  // node:22-slim Docker image so the query engine resolves inside the container.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ──────────────────────────────────────

enum Role {
  ADMIN
  SALES
  WAREHOUSE
  ACCOUNTS
}

enum CustomerType {
  WHOLESALE
  RETAIL
}

enum CustomerStatus {
  ACTIVE
  LEAD
  INACTIVE
}

enum MovementType {
  PURCHASE_IN
  CHALLAN_OUT
  MANUAL_ADJUST
}

enum ChallanStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

// ─────────────────────────────── Models ─────────────────────────────────────

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role     @default(SALES)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  stockLogs StockLog[]
  challans  Challan[]  @relation("ChallanCreatedBy")

  @@index([role])
  @@map("users")
}

model Customer {
  id            String         @id @default(uuid()) @db.Uuid
  businessName  String         @map("business_name")
  contactPerson String         @map("contact_person")
  mobile        String
  email         String?
  gstin         String?        @db.VarChar(15)
  type          CustomerType   @default(WHOLESALE)
  status        CustomerStatus @default(LEAD)
  notes         String?
  followUpDate  DateTime?      @map("follow_up_date") @db.Date

  // Delivery address (used as the challan "bill-to"/"ship-to").
  addressLine1 String? @map("address_line1")
  city         String?
  state        String?
  pincode      String? @db.VarChar(10)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  challans Challan[]

  @@index([status])
  @@index([businessName])
  @@index([gstin])
  @@map("customers")
}

model Product {
  id                String  @id @default(uuid()) @db.Uuid
  sku               String  @unique
  name              String
  category          String
  unitPrice         Decimal @map("unit_price") @db.Decimal(12, 2)
  stockQuantity     Int     @default(0) @map("stock_quantity")
  minStock          Int     @default(0) @map("min_stock")
  warehouseLocation String  @map("warehouse_location")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stockLogs    StockLog[]
  challanItems ChallanItem[]

  @@index([category])
  @@index([name])
  @@map("products")
}

model StockLog {
  id             String       @id @default(uuid()) @db.Uuid
  productId      String       @map("product_id") @db.Uuid
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantityChange Int          @map("quantity_change") // signed: +in / -out
  movementType   MovementType @map("movement_type")
  reason         String
  userId         String       @map("user_id") @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([productId])
  @@index([movementType])
  @@index([createdAt])
  @@map("stock_logs")
}

model Challan {
  id            String        @id @default(uuid()) @db.Uuid
  challanNumber String        @unique @map("challan_number")
  customerId    String        @map("customer_id") @db.Uuid
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  subtotal      Decimal       @default(0) @db.Decimal(14, 2)
  taxAmount     Decimal       @default(0) @map("tax_amount") @db.Decimal(14, 2)
  totalAmount   Decimal       @default(0) @map("total_amount") @db.Decimal(14, 2)
  status        ChallanStatus @default(DRAFT)
  createdById   String        @map("created_by_id") @db.Uuid
  createdBy     User          @relation("ChallanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedAt   DateTime?     @map("confirmed_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  items ChallanItem[]

  @@index([customerId])
  @@index([status])
  @@index([createdById])
  @@index([createdAt])
  @@map("challans")
}

model ChallanItem {
  id                  String  @id @default(uuid()) @db.Uuid
  challanId           String  @map("challan_id") @db.Uuid
  challan             Challan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  productId           String  @map("product_id") @db.Uuid
  product             Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  // Immutable snapshots — frozen at line-item creation so historical challans
  // never change if the product is later renamed/repriced.
  productNameSnapshot String  @map("product_name_snapshot")
  skuSnapshot         String  @map("sku_snapshot")
  unitPriceSnapshot   Decimal @map("unit_price_snapshot") @db.Decimal(12, 2)
  quantity            Int
  lineTotal           Decimal @map("line_total") @db.Decimal(14, 2)

  @@unique([challanId, productId])
  @@index([challanId])
  @@index([productId])
  @@map("challan_items")
}
