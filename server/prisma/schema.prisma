// ─────────────────────────────────────────────────────────────────────────────
// Fundsroom ERP + CRM — PostgreSQL schema (Prisma 6)
//
// Conventions:
//   • Models are PascalCase; tables/columns are mapped to snake_case (@map/@@map).
//   • Money is Decimal(@db.Decimal) — NEVER Float — to avoid rounding drift.
//   • UUID primary keys; foreign keys are indexed; enums model fixed domains.
//   • A DB-level CHECK (stock_quantity >= 0) is added at startup (see
//     src/db/constraints.ts) so zero-negative-stock is guaranteed by the
//     database, not only by application code.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
  // `native` covers local dev (Windows/macOS/Linux); the debian target is for the
  // node:22-slim Docker image so the query engine resolves inside the container.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ──────────────────────────────────────

enum Role {
  ADMIN
  SALES
  WAREHOUSE
  ACCOUNTS
}

enum CustomerType {
  WHOLESALE
  RETAIL
}

enum CustomerStatus {
  ACTIVE
  LEAD
  INACTIVE
}

enum MovementType {
  PURCHASE_IN
  CHALLAN_OUT
  MANUAL_ADJUST
}

enum ChallanStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

/** Conditions the notification agent watches for. */
enum NotificationType {
  OUT_OF_STOCK
  LOW_STOCK
  DRAFT_STALE
  FOLLOW_UP_DUE
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

// ─────────────────────────────── Models ─────────────────────────────────────

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role     @default(SALES)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  stockLogs     StockLog[]
  challans      Challan[]      @relation("ChallanCreatedBy")
  payments      Payment[]      @relation("PaymentCreatedBy")
  googleAccount GoogleAccount?

  @@index([role])
  @@map("users")
}

model Customer {
  id            String         @id @default(uuid()) @db.Uuid
  businessName  String         @map("business_name")
  contactPerson String         @map("contact_person")
  mobile        String
  email         String?
  gstin         String?        @db.VarChar(15)
  type          CustomerType   @default(WHOLESALE)
  status        CustomerStatus @default(LEAD)
  notes         String?
  followUpDate  DateTime?      @map("follow_up_date") @db.Date

  // Delivery address (used as the challan "bill-to"/"ship-to").
  addressLine1 String? @map("address_line1")
  city         String?
  state        String?
  pincode      String? @db.VarChar(10)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  challans Challan[]
  payments Payment[]

  @@index([status])
  @@index([businessName])
  @@index([gstin])
  @@map("customers")
}

model Product {
  id                String  @id @default(uuid()) @db.Uuid
  sku               String  @unique
  name              String
  category          String
  unitPrice         Decimal @map("unit_price") @db.Decimal(12, 2)
  stockQuantity     Int     @default(0) @map("stock_quantity")
  minStock          Int     @default(0) @map("min_stock")
  warehouseLocation String  @map("warehouse_location")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stockLogs    StockLog[]
  challanItems ChallanItem[]

  @@index([category])
  @@index([name])
  @@map("products")
}

model StockLog {
  id             String       @id @default(uuid()) @db.Uuid
  productId      String       @map("product_id") @db.Uuid
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantityChange Int          @map("quantity_change") // signed: +in / -out
  movementType   MovementType @map("movement_type")
  reason         String
  userId         String       @map("user_id") @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([productId])
  @@index([movementType])
  @@index([createdAt])
  @@map("stock_logs")
}

model Challan {
  id            String        @id @default(uuid()) @db.Uuid
  challanNumber String        @unique @map("challan_number")
  customerId    String        @map("customer_id") @db.Uuid
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  subtotal      Decimal       @default(0) @db.Decimal(14, 2)
  taxAmount     Decimal       @default(0) @map("tax_amount") @db.Decimal(14, 2)
  totalAmount   Decimal       @default(0) @map("total_amount") @db.Decimal(14, 2)
  status        ChallanStatus @default(DRAFT)
  createdById   String        @map("created_by_id") @db.Uuid
  createdBy     User          @relation("ChallanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedAt   DateTime?     @map("confirmed_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  items    ChallanItem[]
  payments Payment[]

  @@index([customerId])
  @@index([status])
  @@index([createdById])
  @@index([createdAt])
  @@map("challans")
}

model ChallanItem {
  id                  String  @id @default(uuid()) @db.Uuid
  challanId           String  @map("challan_id") @db.Uuid
  challan             Challan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  productId           String  @map("product_id") @db.Uuid
  product             Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  // Immutable snapshots — frozen at line-item creation so historical challans
  // never change if the product is later renamed/repriced.
  productNameSnapshot String  @map("product_name_snapshot")
  skuSnapshot         String  @map("sku_snapshot")
  unitPriceSnapshot   Decimal @map("unit_price_snapshot") @db.Decimal(12, 2)
  quantity            Int
  lineTotal           Decimal @map("line_total") @db.Decimal(14, 2)

  @@unique([challanId, productId])
  @@index([challanId])
  @@index([productId])
  @@map("challan_items")
}

/**
 * Alerts raised by the notification agent (src/services/agent.service.ts).
 *
 * The table is a live view of currently-open issues, not an append-only log:
 * each scan reconciles it against reality, inserting new conditions and
 * clearing ones that have been resolved. `@@unique([type, entityId])` is what
 * makes a repeated scan idempotent — the same low-stock SKU can only ever hold
 * one open alert, so re-running the agent never duplicates or resets read state.
 */
model Notification {
  id        String               @id @default(uuid()) @db.Uuid
  type      NotificationType
  severity  NotificationSeverity @default(INFO)
  title     String
  body      String
  /** The row this alert is about — product, challan or customer id. */
  entityId  String?              @map("entity_id") @db.Uuid
  /** Human-facing reference (SKU, challan number) for display and search. */
  entityRef String?              @map("entity_ref")
  /** Deep link into the app, e.g. /products. */
  href      String?
  readAt    DateTime?            @map("read_at")
  createdAt DateTime             @default(now()) @map("created_at")

  @@unique([type, entityId])
  @@index([readAt])
  @@index([createdAt])
  @@map("notifications")
}

/**
 * A user's linked Google account and Workspace grant.
 *
 * Tokens are stored encrypted (see src/utils/crypto.ts) because the requested
 * scopes allow reading/writing Sheets and Calendar and sending mail as the user.
 * `refreshToken` is nullable: Google only returns one on the first consent, so
 * an existing value must be preserved when re-consenting.
 */
model GoogleAccount {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @unique @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** Google's stable subject id — the identity to match on, not the email. */
  googleSub    String    @unique @map("google_sub")
  email        String
  name         String?
  picture      String?
  accessToken  String?   @map("access_token")
  refreshToken String?   @map("refresh_token")
  expiresAt    DateTime? @map("expires_at")
  /** Space-separated scopes actually granted, which may be fewer than asked. */
  scope        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("google_accounts")
}

/** How a receipt reached us. ADJUSTMENT covers write-offs and credit notes. */
enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
  CARD
  ADJUSTMENT
}

/**
 * A receipt against a confirmed challan.
 *
 * Part-payments are the norm in wholesale, so a challan has many payments and
 * the outstanding balance is `totalAmount - SUM(payments)`. That sum is never
 * cached on the challan: a stored balance and a payment row can disagree after a
 * failure, whereas a derived one cannot. The invariant that the sum may not
 * exceed the challan total is enforced in a transaction (see payment.service).
 *
 * `customerId` is denormalised from the challan so per-customer receivables and
 * aging don't need a join through challans on every query.
 */
model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  challanId   String        @map("challan_id") @db.Uuid
  challan     Challan       @relation(fields: [challanId], references: [id], onDelete: Cascade)
  customerId  String        @map("customer_id") @db.Uuid
  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  amount      Decimal       @db.Decimal(14, 2)
  method      PaymentMethod @default(BANK_TRANSFER)
  /** UTR, cheque number, UPI reference — whatever identifies it on a statement. */
  reference   String?
  note        String?
  paidAt      DateTime      @map("paid_at")
  createdById String        @map("created_by_id") @db.Uuid
  createdBy   User          @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([challanId])
  @@index([customerId])
  @@index([paidAt])
  @@map("payments")
}
