# ─────────────────────────────────────────────────────────────
# Fundsroom ERP — backend environment
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# PostgreSQL connection string.
# Local dev (with `docker compose up db`): host is localhost.
DATABASE_URL="postgresql://fundsroom:fundsroom@localhost:5432/fundsroom?schema=public"

# JWT secrets — generate strong random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET="replace-me-with-a-long-random-string-min-32-bytes"
JWT_REFRESH_SECRET="replace-me-with-a-DIFFERENT-long-random-string"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# JWT issuer/audience claims (validated on every verify).
JWT_ISSUER="fundsroom-erp"
JWT_AUDIENCE="fundsroom-web"

# CORS: comma-separated list of allowed browser origins.
CORS_ORIGIN="http://localhost:5173,http://localhost:8080"

# Rate limiting (global window).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Run the seed automatically on container startup (docker only).
RUN_SEED=true

# ── AI assistant (optional) ─────────────────────────────────────────────────
# Any OpenAI-compatible provider works — just change the base URL + model.
# Leave AI_API_KEY empty to keep AI disabled (endpoints return 503 cleanly).
#
#   Groq (fast, free tier):  https://console.groq.com/keys
#     AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=llama-3.3-70b-versatile
#   OpenRouter:
#     AI_BASE_URL=https://openrouter.ai/api/v1     AI_MODEL=meta-llama/llama-3.3-70b-instruct
#   OpenAI:
#     AI_BASE_URL=https://api.openai.com/v1        AI_MODEL=gpt-4o-mini
AI_PROVIDER=groq
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_MAX_TOKENS=900
